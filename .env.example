APP_NAME=Lumen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

CACHE_DRIVER=file
QUEUE_CONNECTION=rabbitmq
REDIS_CLIENT=predis

# Old ERP loan sync (OldErpLoanSyncJob): only loans created on/after OLD_ERP_LOAN_SYNC_FROM sync; empty = disabled
OLD_ERP_API_URL=http://30.30.28.73:8080/erp/erp/api
OLD_ERP_API_KEY=
OLD_ERP_LOAN_SYNC_FROM=
# Old ERP late consider sync (OldErpLateConsiderSyncJob): only months >= this YYYY-MM sync; empty = disabled
OLD_ERP_LATE_CONSIDER_SYNC_FROM=
# Old ERP attendance sync (OldErpAttendanceSyncJob): manual entries / approved corrections dated in this month (YYYY-MM) onward; empty = disabled
OLD_ERP_ATTENDANCE_SYNC_FROM=
# Catch-up loop (old-erp:resync): records changed in the last N days, every N seconds
HR_BG_OLD_ERP_RESYNC_DAYS=7
HR_BG_OLD_ERP_RESYNC_EVERY=86400
# Keep failed jobs (failed_jobs table); "null" throws them away
QUEUE_FAILED_DRIVER=database-uuids
# Job alerts (app/Support/Alert.php): Slack-compatible incoming webhook; empty = alerts go to the log only.
# Set the same URL in task-scheduler/.env so its hr-bg-down alert reaches the same channel.
JOB_ALERT_WEBHOOK_URL=
# Jobs never alerted on (still recorded in job_runs), comma-separated, e.g. legacySync
JOB_ALERT_MUTE=
# Daily digest time (HH:MM, Asia/Dhaka)
JOB_DIGEST_AT=09:00
# Optional: alerts link "run #id" to <JOB_DASHBOARD_URL>/runs/<id> (Phase 4)
JOB_DASHBOARD_URL=
# Job dashboard / API (/jobs, /api/jobs/*). No roles exist in this ERP, so access is by user id:
# viewers can read runs and logs; admins can also retry, replay and run-now. Empty = nobody.
JOBS_VIEWER_USER_IDS=
JOBS_ADMIN_USER_IDS=
# Full access with an X-Internal-Token header (scripts, ops). Empty = off.
JOBS_INTERNAL_TOKEN=
# Where tokens are checked (the same endpoint the api-gateway uses)
AUTH_VALIDATE_URL=http://auth:3001/api/auth/validate-token
