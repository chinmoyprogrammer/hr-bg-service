# Laravel & Lumen specific
/vendor
/node_modules

# Laravel environment files
.env
.env.*   # e.g., .env.testing, .env.local

# Laravel cache and logs
/storage/*.key
/storage/app/public/*
/storage/debugbar/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Composer & npm/yarn
composer.lock
yarn.lock
package-lock.json

# IDE/editor folders and files
.idea/
.history/
.vscode/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
Thumbs.db

# PHPUnit
phpunit.result.cache
.phpunit.result.cache

# Coverage reports
coverage/

# Nginx or Apache temp files (optional)
*.pid
*.seed

# Custom build or deployment
/build/

/app/Http/Controllers/DemoController.php
